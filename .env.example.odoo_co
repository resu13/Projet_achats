# === Déploiement odoo_co ===
# Modèle uniquement. Copier vers .env.odoo_co, remplacer toutes les valeurs
# et ne jamais versionner le fichier rempli.
COMPOSE_ENV_FILE=.env.odoo_co
COMPOSE_PROJECT_NAME=achats_odoo_co

# Django
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=
DJANGO_SETTINGS_MODULE=config.settings.production

# Entreprise
ENTREPRISE=odoo_co
ERP_TYPE=odoo
NOM_ENTREPRISE=
LOGO_ENTREPRISE=/app/media/logo_odoo_co.png

# Base de données PostgreSQL
DB_NAME=achats_odoo_co
DB_USER=achats_user
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# Google Drive
DRIVE_FOLDER_ID=
# Chemin hôte Docker vers le JSON du compte de service (ne pas versionner le fichier).
GOOGLE_KEY_FILE_SOURCE=./secrets/google_key_odoo_co.json
# Chemin du fichier dans les conteneurs backend/celery.
GOOGLE_KEY_FILE=/run/secrets/google_key.json
TLS_CERT_FILE_SOURCE=./secrets/tls/odoo_co/fullchain.pem
TLS_KEY_FILE_SOURCE=./secrets/tls/odoo_co/privkey.pem

# Odoo
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_KEY=

# Fichiers
TAILLE_MAX_FICHIER_MO=20

# Validation BR (non applicable pour Odoo, ignoré)
REAUTH_VALIDATION_BR=False

# Redis / Celery
REDIS_URL=redis://redis:6379/0
