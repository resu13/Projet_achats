# === Déploiement urium_co ===
# Modèle uniquement. Copier vers .env.urium_co, remplacer toutes les valeurs
# et ne jamais versionner le fichier rempli.
COMPOSE_ENV_FILE=.env.urium_co
COMPOSE_PROJECT_NAME=achats_urium_co

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=
DJANGO_SETTINGS_MODULE=config.settings.production

ENTREPRISE=urium_co
ERP_TYPE=urium
NOM_ENTREPRISE=
LOGO_ENTREPRISE=/app/media/logo_urium_co.png

DB_NAME=achats_urium_co
DB_USER=achats_user
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

DRIVE_FOLDER_ID=
# Chemin hôte Docker vers le JSON du compte de service (ne pas versionner le fichier).
GOOGLE_KEY_FILE_SOURCE=./secrets/google_key_urium_co.json
# Chemin du fichier dans les conteneurs backend/celery.
GOOGLE_KEY_FILE=/run/secrets/google_key.json
TLS_CERT_FILE_SOURCE=./secrets/tls/urium_co/fullchain.pem
TLS_KEY_FILE_SOURCE=./secrets/tls/urium_co/privkey.pem

# BLOQUANT : le contrat REST Urium (URL, routes, authentification, formats)
# reste à définir. Les BC ne seront pas disponibles via l'ERP avant intégration.

TAILLE_MAX_FICHIER_MO=20
REAUTH_VALIDATION_BR=False

REDIS_URL=redis://redis:6379/0
